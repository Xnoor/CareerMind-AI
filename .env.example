# Database URL (PostgreSQL in production/Docker, or SQLite fallback sqlite:///./careermind.db for zero-config local run)
DATABASE_URL=sqlite:///./careermind.db

# JWT Auth Secret Key
JWT_SECRET=careermind_ai_super_secret_jwt_key_2026

# LLM Provider API Keys (Optional - Local intelligent fallback engine active if blank)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Frontend API Base URL
VITE_API_BASE_URL=/api
